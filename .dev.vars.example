# Copy to .dev.vars and fill in your key from https://www.subconscious.dev/platform
SUBCONSCIOUS_API_KEY=sky_your_key_here

# Optional: require this header on POST /api/webhook
# WEBHOOK_SECRET=your-webhook-secret

# Slack app (Freight negotiator HITL / approvals) — from https://api.slack.com/apps
# SLACK_APP_ID=A0XXXXXXXX
# SLACK_CLIENT_ID=your-client-id
# SLACK_CLIENT_SECRET=your-client-secret
# SLACK_SIGNING_SECRET=your-signing-secret
# SLACK_VERIFICATION_TOKEN=your-verification-token
